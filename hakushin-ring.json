    { "id": "R2", "text": "The outer ring, with its clasps, spins a full turn inside the hoop with at least 1 mm to spare.", "check": "outer_sweep + 1 <= hoop_ir" },
    { "id": "R3", "text": "The inner ring, with its clasps, tumbles a full turn inside the outer ring with at least 1 mm to spare.", "check": "sqrt((inner_or + clasp_wall + clasp_fit) ^ 2 + (ring_t / 2 + clasp_wall + clasp_fit) ^ 2 + (clasp_len / 2 - 1) ^ 2) + 1 <= outer_ir" },
    { "id": "R4", "text": "The innermost ring turns a full turn inside the inner ring with at least 1 mm to spare.", "check": "sqrt(innermost_or ^ 2 + (ring_t / 2) ^ 2) + 1 <= inner_ir" },
    { "id": "R5", "text": "The crest spins freely inside the innermost ring with at least 2 mm to spare.", "check": "crest_reach + 2 <= innermost_ir" },
    { "id": "R6", "text": "Every pivot pin reaches at least 4 mm into the ring that turns on it, without passing through it.", "check": "pin_a_l - ring_w - gap >= 4 and pin_a_l - ring_w - gap <= outer_w and pin_b_l - outer_w - gap >= 4 and pin_b_l - outer_w - gap <= ring_w and pin_c_l - ring_w - gap >= 4 and pin_c_l - ring_w - gap <= innermost_w" },
    { "id": "R7", "text": "The outer ring clears the saddle as it spins.", "check": "sqrt((hoop_or - ring_w) ^ 2 + ((ring_t + 0.3) / 2) ^ 2) >= sqrt(outer_or ^ 2 + (outer_t / 2) ^ 2) + 1" },
    { "id": "R8", "text": "The largest printed part, the hoop, fits the printer bed with 10 mm margin all round.", "check": "2 * hoop_or + 20 <= bed" },
    { "id": "R9", "text": "The tassels hang clear of the base by at least 10 mm.", "check": "tassel_z - tassel_len >= base_t + 10" },
    { "id": "R10", "text": "The spinning outer ring misses the hanging tassels: 2 mm from each tassel head and 2 mm from its cord.", "check": "tassel_x - 4.5 >= sqrt(outer_sweep ^ 2 - (hoop_rc * sin(tassel_angle) + tassel_len / 3) ^ 2) + 2 and tassel_x - 0.75 >= sqrt(outer_sweep ^ 2 - (hoop_rc * sin(tassel_angle)) ^ 2) + 2" },
    { "id": "R11", "text": "The base is wide enough not to tip: at least 70% of the hoop's diameter.", "check": "base_d >= 0.7 * 2 * hoop_or" },
