    {
      "id": "R1",
      "text": "No two parts intersect.",
      "check": "interferences == 0"
    },
    {
      "id": "R2",
      "text": "The largest printed part, the ring, fits the printer bed with 10 mm margin all round.",
      "check": "2 * ring_or + 20 <= bed"
    },
    {
      "id": "R3",
      "text": "Every glued step is at least 3 mm wide.",
      "check": "lap >= 3 and lap_ring >= 3"
    },
    {
      "id": "R4",
      "text": "The horns stay at least 3 mm inside the inner band.",
      "check": "horn_tip + 3 <= band_ir"
    },
    {
      "id": "R5",
      "text": "The collar reaches from the crest to the band with its steps to spare.",
      "check": "band_ir - crest_r >= 10"
    },
    {
      "id": "R6",
      "text": "The gold shells stop short of the inner band.",
      "check": "ring_rc + (ring_a + shell) * -0.866 >= ring_ir + 0.05"
    },
    {
      "id": "R7",
      "text": "The cradle groove holds at least 12 mm of the ring.",
      "check": "groove >= 12"
    },
    {
      "id": "R8",
      "text": "The tassel hangers and clasps sit clear of the cradle.",
      "check": "(ring_or + shell) * sin(90 - hanger_angle - hanger_span / 2) >= cradle_w / 2 + 5"
    },
    {
      "id": "R9",
      "text": "The tassels hang outside the base and end at least 15 mm above the table.",
      "check": "eye_x - 6 >= base_d / 2 and tassel_bottom >= 15"
    },
    {
      "id": "R10",
      "text": "The base is at least 60% as wide as the ring, so the piece does not tip.",
      "check": "base_d >= 0.6 * 2 * ring_or"
    },
    {
      "id": "R11",
      "text": "A desk piece: no taller than 230 mm and under 0.6 kg.",
